<?xml version="1.0" ?>
<!-- A minimal grocery aisle: ground, lights, and one open-faced shelf unit.
     The robot (spawned from shelf_description) parks in front facing +x and
     places cans on the shelf board. Coordinates: x forward, y left, z up. -->
<sdf version="1.9">
  <world name="store_aisle">

    <physics name="1ms" type="dart">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system"
            name="gz::sim::systems::Contact"/>
    <!-- Renders camera/lidar. Harmless if it can't init a GPU in headless
         CPU mode; the known-pose mission does not depend on rendered data. -->
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.8 0.85 0.9 1</background>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.2 -1</direction>
    </light>

    <!-- Floor -->
    <model name="floor">
      <static>true</static>
      <link name="link">
        <collision name="c">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="v">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Open-faced shelf unit. Board top surface at z = 0.82, front edge at
         x = 1.45, spanning y = [-0.45, 0.45]. Slot origin documented in the
         planogram (shelf_bringup/config/planogram.yaml). -->
    <model name="grocery_shelf">
      <static>true</static>
      <pose>1.70 0 0 0 0 0</pose>
      <link name="frame">
        <!-- back panel -->
        <collision name="back_c">
          <pose>0.225 0 0.8 0 0 0</pose>
          <geometry><box><size>0.05 0.95 1.6</size></box></geometry>
        </collision>
        <visual name="back_v">
          <pose>0.225 0 0.8 0 0 0</pose>
          <geometry><box><size>0.05 0.95 1.6</size></box></geometry>
          <material><ambient>0.5 0.4 0.3 1</ambient><diffuse>0.6 0.5 0.4 1</diffuse></material>
        </visual>
        <!-- the shelf board the robot stocks (top surface z = 0.82) -->
        <collision name="board_c">
          <pose>0 0 0.80 0 0 0</pose>
          <geometry><box><size>0.50 0.95 0.04</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="board_v">
          <pose>0 0 0.80 0 0 0</pose>
          <geometry><box><size>0.50 0.95 0.04</size></box></geometry>
          <material><ambient>0.6 0.5 0.4 1</ambient><diffuse>0.7 0.6 0.5 1</diffuse></material>
        </visual>
        <!-- side panels -->
        <collision name="left_c">
          <pose>0 0.475 0.8 0 0 0</pose>
          <geometry><box><size>0.50 0.02 1.6</size></box></geometry>
        </collision>
        <visual name="left_v">
          <pose>0 0.475 0.8 0 0 0</pose>
          <geometry><box><size>0.50 0.02 1.6</size></box></geometry>
          <material><ambient>0.5 0.4 0.3 1</ambient><diffuse>0.6 0.5 0.4 1</diffuse></material>
        </visual>
        <collision name="right_c">
          <pose>0 -0.475 0.8 0 0 0</pose>
          <geometry><box><size>0.50 0.02 1.6</size></box></geometry>
        </collision>
        <visual name="right_v">
          <pose>0 -0.475 0.8 0 0 0</pose>
          <geometry><box><size>0.50 0.02 1.6</size></box></geometry>
          <material><ambient>0.5 0.4 0.3 1</ambient><diffuse>0.6 0.5 0.4 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
