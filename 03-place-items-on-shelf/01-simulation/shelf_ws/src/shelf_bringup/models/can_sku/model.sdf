<?xml version="1.0" ?>
<!-- One rigid SKU: a can, radius 0.033 m, height 0.12 m, mass 0.15 kg.
     Mass is kept light and friction high so a parallel-jaw friction grasp
     in Gazebo is reliable (grasping is the known-hard part — see
     ../../05-manipulation.md). Inertia is the solid-cylinder tensor. -->
<sdf version="1.9">
  <model name="can_sku">
    <link name="link">
      <inertial>
        <mass>0.15</mass>
        <inertia>
          <ixx>0.00022</ixx>
          <iyy>0.00022</iyy>
          <izz>0.0000817</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.033</radius><length>0.12</length></cylinder></geometry>
        <surface>
          <friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction>
          <contact><ode><kp>100000</kp><kd>1.0</kd></ode></contact>
        </surface>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.033</radius><length>0.12</length></cylinder></geometry>
        <material><ambient>0.8 0.1 0.1 1</ambient><diffuse>0.9 0.2 0.2 1</diffuse></material>
      </visual>
    </link>
  </model>
</sdf>
