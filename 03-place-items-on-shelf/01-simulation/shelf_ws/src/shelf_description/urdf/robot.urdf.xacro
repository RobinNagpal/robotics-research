<?xml version="1.0"?>
<!-- Mobile manipulator: differential-drive base + 5-DoF arm + parallel
     gripper + tray + lidar + wrist RGB-D, in one kinematic tree.
     Spawn at z = 0.175 so the wheels touch the ground.
     The arm is driven by IK (ikpy) to known tray/shelf poses (see
     shelf_bringup scripts); links are sized so those poses are reachable. -->
<robot name="shelf_bot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="controllers_yaml" default=""/>

  <!-- ===================== helper macros ===================== -->
  <xacro:macro name="box_inertia" params="m x y z">
    <inertial>
      <mass value="${m}"/>
      <inertia
        ixx="${m*(y*y+z*z)/12.0}" iyy="${m*(x*x+z*z)/12.0}" izz="${m*(x*x+y*y)/12.0}"
        ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cyl_inertia" params="m r l">
    <inertial>
      <mass value="${m}"/>
      <inertia
        ixx="${m*(3*r*r+l*l)/12.0}" iyy="${m*(3*r*r+l*l)/12.0}" izz="${m*r*r/2.0}"
        ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </xacro:macro>

  <material name="grey"><color rgba="0.4 0.4 0.45 1"/></material>
  <material name="dark"><color rgba="0.15 0.15 0.15 1"/></material>
  <material name="blue"><color rgba="0.2 0.4 0.8 1"/></material>
  <material name="metal"><color rgba="0.6 0.6 0.65 1"/></material>

  <!-- ===================== base ===================== -->
  <link name="base_link">
    <visual>
      <geometry><box size="0.40 0.40 0.15"/></geometry>
      <material name="blue"/>
    </visual>
    <collision><geometry><box size="0.40 0.40 0.15"/></geometry></collision>
    <xacro:box_inertia m="15.0" x="0.40" y="0.40" z="0.15"/>
  </link>

  <!-- drive wheels (continuous, velocity-controlled) -->
  <xacro:macro name="wheel" params="name y">
    <link name="${name}">
      <visual>
        <origin rpy="1.5708 0 0"/>
        <geometry><cylinder radius="0.10" length="0.05"/></geometry>
        <material name="dark"/>
      </visual>
      <collision>
        <origin rpy="1.5708 0 0"/>
        <geometry><cylinder radius="0.10" length="0.05"/></geometry>
      </collision>
      <xacro:cyl_inertia m="1.0" r="0.10" l="0.05"/>
    </link>
    <joint name="${name}_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}"/>
      <origin xyz="0 ${y} -0.075"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>
  <xacro:wheel name="left_wheel" y="0.225"/>
  <xacro:wheel name="right_wheel" y="-0.225"/>

  <!-- front caster (passive) -->
  <link name="caster">
    <visual><geometry><sphere radius="0.05"/></geometry><material name="dark"/></visual>
    <collision><geometry><sphere radius="0.05"/></geometry></collision>
    <xacro:cyl_inertia m="0.3" r="0.05" l="0.05"/>
  </link>
  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/><child link="caster"/>
    <origin xyz="0.15 0 -0.125"/>
  </joint>

  <!-- column carrying the arm -->
  <link name="column">
    <visual><geometry><box size="0.12 0.12 0.25"/></geometry><material name="grey"/></visual>
    <collision><geometry><box size="0.12 0.12 0.25"/></geometry></collision>
    <xacro:box_inertia m="3.0" x="0.12" y="0.12" z="0.25"/>
  </link>
  <joint name="column_joint" type="fixed">
    <parent link="base_link"/><child link="column"/>
    <origin xyz="-0.05 0 0.20"/>
  </joint>

  <!-- tray deck in front of the column; cans are spawned into its cells -->
  <link name="tray">
    <visual><geometry><box size="0.26 0.36 0.02"/></geometry><material name="metal"/></visual>
    <collision>
      <geometry><box size="0.26 0.36 0.02"/></geometry>
    </collision>
    <xacro:box_inertia m="1.0" x="0.26" y="0.36" z="0.02"/>
  </link>
  <joint name="tray_joint" type="fixed">
    <parent link="base_link"/><child link="tray"/>
    <origin xyz="0.25 0 0.18"/>
  </joint>

  <!-- ===================== 5-DoF arm ===================== -->
  <!-- arm base at base_link z=0.325 -> world z=0.5 when spawned -->
  <link name="arm_base">
    <visual><geometry><cylinder radius="0.06" length="0.06"/></geometry><material name="metal"/></visual>
    <collision><geometry><cylinder radius="0.06" length="0.06"/></geometry></collision>
    <xacro:cyl_inertia m="1.0" r="0.06" l="0.06"/>
  </link>
  <joint name="arm_base_joint" type="fixed">
    <parent link="base_link"/><child link="arm_base"/>
    <origin xyz="-0.05 0 0.325"/>
  </joint>

  <xacro:macro name="arm_link" params="name len r">
    <link name="${name}">
      <visual>
        <origin xyz="0 0 ${len/2.0}"/>
        <geometry><cylinder radius="${r}" length="${len}"/></geometry>
        <material name="metal"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${len/2.0}"/>
        <geometry><cylinder radius="${r}" length="${len}"/></geometry>
      </collision>
      <xacro:cyl_inertia m="1.2" r="${r}" l="${len}"/>
    </link>
  </xacro:macro>

  <!-- joint 1: shoulder pan (about z) -->
  <link name="shoulder">
    <visual><geometry><sphere radius="0.05"/></geometry><material name="grey"/></visual>
    <collision><geometry><sphere radius="0.05"/></geometry></collision>
    <xacro:cyl_inertia m="0.8" r="0.05" l="0.05"/>
  </link>
  <joint name="joint_pan" type="revolute">
    <parent link="arm_base"/><child link="shoulder"/>
    <origin xyz="0 0 0.06"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="60" velocity="2.0"/>
  </joint>

  <!-- joint 2: shoulder lift (about y) -> upper arm -->
  <xacro:arm_link name="upper_arm" len="0.40" r="0.04"/>
  <joint name="joint_lift" type="revolute">
    <parent link="shoulder"/><child link="upper_arm"/>
    <origin xyz="0 0 0.04"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.14" upper="3.14" effort="60" velocity="2.0"/>
  </joint>

  <!-- joint 3: elbow (about y) -> forearm -->
  <xacro:arm_link name="forearm" len="0.35" r="0.035"/>
  <joint name="joint_elbow" type="revolute">
    <parent link="upper_arm"/><child link="forearm"/>
    <origin xyz="0 0 0.40"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.14" upper="3.14" effort="40" velocity="2.0"/>
  </joint>

  <!-- joint 4: wrist pitch (about y) -> wrist -->
  <xacro:arm_link name="wrist" len="0.10" r="0.03"/>
  <joint name="joint_wrist_pitch" type="revolute">
    <parent link="forearm"/><child link="wrist"/>
    <origin xyz="0 0 0.35"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.14" upper="3.14" effort="20" velocity="2.0"/>
  </joint>

  <!-- joint 5: wrist roll (about z) -> gripper base -->
  <link name="gripper_base">
    <visual><geometry><box size="0.08 0.12 0.04"/></geometry><material name="dark"/></visual>
    <collision><geometry><box size="0.08 0.12 0.04"/></geometry></collision>
    <xacro:box_inertia m="0.4" x="0.08" y="0.12" z="0.04"/>
  </link>
  <joint name="joint_wrist_roll" type="revolute">
    <parent link="wrist"/><child link="gripper_base"/>
    <origin xyz="0 0 0.10"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="20" velocity="2.0"/>
  </joint>

  <!-- grasp reference frame at the fingertips (tool point) -->
  <link name="tool"/>
  <joint name="tool_joint" type="fixed">
    <parent link="gripper_base"/><child link="tool"/>
    <origin xyz="0 0 0.11"/>
  </joint>

  <!-- parallel fingers (prismatic, along y). They extend in +z — the same
       distal direction as the tool frame — so when the wrist points the tool
       down at a can, the fingers straddle it (tool tip sits between them). -->
  <xacro:macro name="finger" params="name sign">
    <link name="${name}">
      <visual>
        <origin xyz="0 0 0.05"/>
        <geometry><box size="0.02 0.02 0.10"/></geometry>
        <material name="metal"/>
      </visual>
      <collision>
        <origin xyz="0 0 0.05"/>
        <geometry><box size="0.02 0.02 0.10"/></geometry>
      </collision>
      <xacro:box_inertia m="0.05" x="0.02" y="0.02" z="0.10"/>
    </link>
    <joint name="${name}_joint" type="prismatic">
      <parent link="gripper_base"/><child link="${name}"/>
      <origin xyz="0 0 0.06"/>
      <axis xyz="0 ${sign} 0"/>
      <limit lower="0.0" upper="0.05" effort="50" velocity="0.5"/>
    </joint>
  </xacro:macro>
  <xacro:finger name="left_finger" sign="1"/>
  <xacro:finger name="right_finger" sign="-1"/>

  <!-- ===================== sensors (gz) ===================== -->
  <link name="lidar"><visual><geometry><cylinder radius="0.04" length="0.05"/></geometry><material name="dark"/></visual>
    <xacro:cyl_inertia m="0.1" r="0.04" l="0.05"/></link>
  <joint name="lidar_joint" type="fixed"><parent link="base_link"/><child link="lidar"/>
    <origin xyz="0.18 0 0.10"/></joint>

  <link name="camera"><visual><geometry><box size="0.03 0.08 0.03"/></geometry><material name="dark"/></visual>
    <xacro:box_inertia m="0.05" x="0.03" y="0.08" z="0.03"/></link>
  <joint name="camera_joint" type="fixed"><parent link="gripper_base"/><child link="camera"/>
    <origin xyz="0.06 0 0" rpy="0 1.5708 0"/></joint>

  <gazebo reference="lidar">
    <sensor name="lidar" type="gpu_lidar">
      <topic>scan</topic>
      <update_rate>10</update_rate>
      <always_on>1</always_on>
      <lidar>
        <scan><horizontal><samples>360</samples><resolution>1</resolution>
          <min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal></scan>
        <range><min>0.12</min><max>10.0</max><resolution>0.01</resolution></range>
      </lidar>
    </sensor>
  </gazebo>

  <gazebo reference="camera">
    <sensor name="wrist_camera" type="rgbd_camera">
      <topic>wrist_camera</topic>
      <update_rate>15</update_rate>
      <always_on>1</always_on>
      <camera>
        <horizontal_fov>1.2</horizontal_fov>
        <image><width>640</width><height>480</height></image>
        <clip><near>0.05</near><far>8.0</far></clip>
      </camera>
    </sensor>
  </gazebo>

  <!-- higher friction on fingers + can contact for a reliable grasp -->
  <gazebo reference="left_finger"><mu1>1.5</mu1><mu2>1.5</mu2></gazebo>
  <gazebo reference="right_finger"><mu1>1.5</mu1><mu2>1.5</mu2></gazebo>

  <!-- ===================== ros2_control ===================== -->
  <ros2_control name="GazeboSystem" type="system">
    <hardware><plugin>gz_ros2_control/GazeboSimSystem</plugin></hardware>

    <joint name="left_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/><state_interface name="velocity"/>
    </joint>
    <joint name="right_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/><state_interface name="velocity"/>
    </joint>

    <xacro:macro name="pos_joint" params="name">
      <joint name="${name}">
        <command_interface name="position"/>
        <state_interface name="position"/><state_interface name="velocity"/>
      </joint>
    </xacro:macro>
    <xacro:pos_joint name="joint_pan"/>
    <xacro:pos_joint name="joint_lift"/>
    <xacro:pos_joint name="joint_elbow"/>
    <xacro:pos_joint name="joint_wrist_pitch"/>
    <xacro:pos_joint name="joint_wrist_roll"/>
    <xacro:pos_joint name="left_finger_joint"/>
    <xacro:pos_joint name="right_finger_joint"/>
  </ros2_control>

  <gazebo>
    <plugin filename="gz_ros2_control-system"
            name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(arg controllers_yaml)</parameters>
    </plugin>
  </gazebo>

</robot>
